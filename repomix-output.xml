package com.questkeep.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.google.gson.Gson
import com.questkeep.domain.entities.NpcCard
import com.questkeep.domain.repository.NpcCardRepository
import com.questkeep.utils.NpcsExport
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch
import java.util.UUID
import javax.inject.Inject

sealed class BestiaryUiState {
    object Loading : BestiaryUiState()
    data class Success(val npcs: List<NpcCard>) : BestiaryUiState()
    data class Error(val message: String) : BestiaryUiState()
}

@HiltViewModel
class BestiaryViewModel @Inject constructor(
    private val npcRepository: NpcCardRepository
) : ViewModel() {

    private val _uiState = MutableStateFlow<BestiaryUiState>(BestiaryUiState.Loading)
    val uiState: StateFlow<BestiaryUiState> = _uiState.asStateFlow()

    private val _editingNpc = MutableStateFlow<NpcCard?>(null)
    val editingNpc: StateFlow<NpcCard?> = _editingNpc.asStateFlow()

    private val _deletingNpc = MutableStateFlow<NpcCard?>(null)
    val deletingNpc: StateFlow<NpcCard?> = _deletingNpc.asStateFlow()

    private var currentCampaignId: String? = null

    fun loadNpcs(campaignId: String) {
        if (campaignId == currentCampaignId) return
        currentCampaignId = campaignId
        viewModelScope.launch {
            npcRepository.getNpcs(campaignId)
                .catch { _uiState.value = BestiaryUiState.Error(it.message ?: "Error") }
                .collect { _uiState.value = BestiaryUiState.Success(it) }
        }
    }

    fun startCreating() {
        _editingNpc.value = NpcCard(campaignId = currentCampaignId ?: "")
    }

    fun startEditing(npc: NpcCard) { _editingNpc.value = npc }
    fun cancelEdit() { _editingNpc.value = null }

    fun saveNpc(npc: NpcCard) {
        viewModelScope.launch {
            val state = _uiState.value
            val isNew = state !is BestiaryUiState.Success ||
                state.npcs.none { it.id == npc.id }
            if (isNew) npcRepository.saveNpc(npc)
            else npcRepository.updateNpc(npc)
            _editingNpc.value = null
        }
    }

    fun requestDelete(npc: NpcCard) { _deletingNpc.value = npc }
    fun cancelDelete() { _deletingNpc.value = null }

    fun confirmDelete() {
        val npc = _deletingNpc.value ?: return
        val cid = currentCampaignId ?: return
        viewModelScope.launch {
            npcRepository.deleteNpc(npc.id, cid)
            _deletingNpc.value = null
        }
    }

    fun exportNpcsJson(): String {
        val npcs = (_uiState.value as? BestiaryUiState.Success)?.npcs ?: emptyList()
        return Gson().toJson(NpcsExport(npcs = npcs))
    }

    fun importNpcsFromJson(json: String) {
        val cid = currentCampaignId ?: return
        try {
            val export = Gson().fromJson(json, NpcsExport::class.java) ?: return
            viewModelScope.launch {
                export.npcs.forEach { npc ->
                    npcRepository.saveNpc(npc.copy(id = UUID.randomUUID().toString(), campaignId = cid))
                }
            }
        } catch (_: Exception) {}
    }
}
</file>

<file path="app/src/main/java/com/questkeep/viewmodel/CampaignViewModel.kt">
package com.questkeep.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.questkeep.domain.entities.Campaign
import com.questkeep.domain.repository.AuthRepository
import com.questkeep.domain.repository.CampaignRepository
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch
import javax.inject.Inject

sealed class CampaignUiEvent {
    data class Error(val message: String) : CampaignUiEvent()
    data class JoinSuccess(val campaignId: String) : CampaignUiEvent()
    data class CreateSuccess(val campaignId: String) : CampaignUiEvent()
    object DeleteSuccess : CampaignUiEvent()
    object UpdateSuccess : CampaignUiEvent()
}

@HiltViewModel
class CampaignViewModel @Inject constructor(
    private val campaignRepository: CampaignRepository,
    private val authRepository: AuthRepository
) : ViewModel() {

    private val _campaigns = MutableStateFlow<List<Campaign>>(emptyList())
    val campaigns: StateFlow<List<Campaign>> = _campaigns.asStateFlow()

    private val _isLoading = MutableStateFlow(false)
    val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()

    private val _events = MutableSharedFlow<CampaignUiEvent>()
    val events: SharedFlow<CampaignUiEvent> = _events.asSharedFlow()

    val currentUserId: String? get() = authRepository.currentUserId

    init { loadCampaigns() }

    private fun loadCampaigns() {
        val userId = authRepository.currentUserId ?: return
        viewModelScope.launch {
            campaignRepository.getCampaignsForUser(userId).collect { _campaigns.value = it }
        }
    }

    fun createCampaign(name: String, description: String, gameSystem: String, maxPlayers: Int) {
        if (name.isBlank()) {
            viewModelScope.launch { _events.emit(CampaignUiEvent.Error("Название кампании обязательно")) }
            return
        }
        val userId = authRepository.currentUserId ?: return
        viewModelScope.launch {
            _isLoading.value = true
            val result = campaignRepository.createCampaign(Campaign(
                name = name.trim(), description = description.trim(),
                gameSystem = gameSystem, maxPlayers = maxPlayers, gmId = userId
            ))
            _isLoading.value = false
            result.fold(
                onSuccess = { _events.emit(CampaignUiEvent.CreateSuccess(it.id)) },
                onFailure = { _events.emit(CampaignUiEvent.Error(it.message ?: "Ошибка создания")) }
            )
        }
    }

    fun joinCampaign(inviteCode: String) {
        if (inviteCode.length != 6) {
            viewModelScope.launch { _events.emit(CampaignUiEvent.Error("Код должен быть 6 символов")) }
            return
        }
        val userId = authRepository.currentUserId ?: return
        viewModelScope.launch {
            _isLoading.value = true
            val result = campaignRepository.joinCampaign(inviteCode.uppercase(), userId)
            _isLoading.value = false
            result.fold(
                onSuccess = { _events.emit(CampaignUiEvent.JoinSuccess(it.id)) },
                onFailure = { _events.emit(CampaignUiEvent.Error(it.message ?: "Кампания не найдена")) }
            )
        }
    }

    fun leaveCampaign(campaignId: String) {
        val userId = authRepository.currentUserId ?: return
        viewModelScope.launch { campaignRepository.leaveCampaign(campaignId, userId) }
    }

    fun deleteCampaign(campaignId: String) {
        viewModelScope.launch {
            _isLoading.value = true
            val result = campaignRepository.deleteCampaign(campaignId)
            _isLoading.value = false
            result.fold(
                onSuccess = { _events.emit(CampaignUiEvent.DeleteSuccess) },
                onFailure = { _events.emit(CampaignUiEvent.Error(it.message ?: "Ошибка удаления")) }
            )
        }
    }

    fun updateCampaign(campaign: Campaign, name: String, description: String, gameSystem: String, maxPlayers: Int) {
        if (name.isBlank()) {
            viewModelScope.launch { _events.emit(CampaignUiEvent.Error("Название не может быть пустым")) }
            return
        }
        viewModelScope.launch {
            _isLoading.value = true
            val result = campaignRepository.updateCampaign(campaign.copy(
                name = name.trim(), description = description.trim(),
                gameSystem = gameSystem, maxPlayers = maxPlayers
            ))
            _isLoading.value = false
            result.fold(
                onSuccess = { _events.emit(CampaignUiEvent.UpdateSuccess) },
                onFailure = { _events.emit(CampaignUiEvent.Error(it.message ?: "Ошибка обновления")) }
            )
        }
    }

    fun addCoGm(campaignId: String, userId: String) {
        viewModelScope.launch {
            val result = campaignRepository.addCoGm(campaignId, userId)
            result.onFailure { _events.emit(CampaignUiEvent.Error(it.message ?: "Ошибка")) }
        }
    }

    fun removeCoGm(campaignId: String, userId: String) {
        viewModelScope.launch {
            val result = campaignRepository.removeCoGm(campaignId, userId)
            result.onFailure { _events.emit(CampaignUiEvent.Error(it.message ?: "Ошибка")) }
        }
    }

    /** Returns true if userId is GM or co-GM of this campaign */
    fun isGm(campaign: Campaign): Boolean {
        val uid = authRepository.currentUserId ?: return false
        return campaign.gmId == uid || campaign.coGmIds.contains(uid)
    }
}
</file>

<file path="app/src/main/java/com/questkeep/viewmodel/CharacterSheetViewModel.kt">
package com.questkeep.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.questkeep.domain.entities.Character
import com.questkeep.domain.repository.AuthRepository
import com.questkeep.domain.repository.CharacterRepository
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.Job
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch
import java.util.UUID
import javax.inject.Inject

sealed class CharacterSheetUiState {
    object Loading : CharacterSheetUiState()
    data class Success(val character: Character) : CharacterSheetUiState()
    object NoCampaign : CharacterSheetUiState()
    object NoCharacter : CharacterSheetUiState()
    data class GmPicker(val characters: List<Character>) : CharacterSheetUiState()
    data class Error(val message: String) : CharacterSheetUiState()
}

@HiltViewModel
class CharacterSheetViewModel @Inject constructor(
    private val characterRepository: CharacterRepository,
    private val authRepository: AuthRepository
) : ViewModel() {

    private val _uiState = MutableStateFlow<CharacterSheetUiState>(CharacterSheetUiState.Loading)
    val uiState: StateFlow<CharacterSheetUiState> = _uiState.asStateFlow()

    private val _showDamageDialog = MutableStateFlow(false)
    val showDamageDialog: StateFlow<Boolean> = _showDamageDialog.asStateFlow()

    private val _showArmorDialog = MutableStateFlow(false)
    val showArmorDialog: StateFlow<Boolean> = _showArmorDialog.asStateFlow()

    private val _showGmEditSheet = MutableStateFlow(false)
    val showGmEditSheet: StateFlow<Boolean> = _showGmEditSheet.asStateFlow()

    private val _showPlayerEditSheet = MutableStateFlow(false)
    val showPlayerEditSheet: StateFlow<Boolean> = _showPlayerEditSheet.asStateFlow()

    private var currentCharacter: Character? = null
    private var isGmMode = false
    private var loadedCampaignId: String? = null
    private var loadingJob: Job? = null

    fun loadCharacter(campaignId: String?, isGm: Boolean = false) {
        if (campaignId == null) { _uiState.value = CharacterSheetUiState.NoCampaign; return }
        if (campaignId == loadedCampaignId && isGm == isGmMode &&
            _uiState.value !is CharacterSheetUiState.Loading) return

        loadedCampaignId = campaignId
        isGmMode = isGm
        loadingJob?.cancel()
        _uiState.value = CharacterSheetUiState.Loading

        loadingJob = viewModelScope.launch {
            if (isGm) {
                characterRepository.getCharactersForCampaign(campaignId)
                    .catch { _uiState.value = CharacterSheetUiState.GmPicker(emptyList()) }
                    .collect { list ->
                        val currentId = currentCharacter?.id
                        if (currentId != null) {
                            val updated = list.find { it.id == currentId }
                            if (updated != null) {
                                currentCharacter = updated
                                _uiState.value = CharacterSheetUiState.Success(updated)
                                return@collect
                            }
                        }
                        _uiState.value = CharacterSheetUiState.GmPicker(list)
                    }
            } else {
                val userId = authRepository.currentUserId ?: return@launch
                characterRepository.getCharacter(campaignId, userId)
                    .catch { _uiState.value = CharacterSheetUiState.Error(it.message ?: "Error") }
                    .collect { character ->
                        if (character == null) _uiState.value = CharacterSheetUiState.NoCharacter
                        else { currentCharacter = character; _uiState.value = CharacterSheetUiState.Success(character) }
                    }
            }
        }
    }

    fun gmSelectCharacter(character: Character) {
        currentCharacter = character
        _uiState.value = CharacterSheetUiState.Success(character)
    }

    fun gmBackToPicker(campaignId: String) {
        currentCharacter = null
        loadedCampaignId = null
        loadCharacter(campaignId, isGm = true)
    }

    fun createCharacter(campaignId: String, name: String, className: String) {
        val userId = authRepository.currentUserId ?: return
        viewModelScope.launch {
            characterRepository.saveCharacter(Character(
                id = UUID.randomUUID().toString(),
                name = name, className = className,
                campaignId = campaignId, playerId = userId,
                maxHp = 10, currentHp = 10
            ))
        }
    }

    fun applyDamage(amount: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(currentHp = (c.currentHp - amount).coerceAtLeast(0)))
    }

    fun applyHealing(amount: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(currentHp = (c.currentHp + amount).coerceAtMost(c.maxHp)))
    }

    fun applyArmorDamage(amount: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(armor = (c.armor - amount).coerceAtLeast(0)))
    }

    fun applyArmorRepair(amount: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(armor = (c.armor + amount).coerceAtMost(c.maxArmor)))
    }

    fun updateInspirationPoints(delta: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(inspirationPoints = (c.inspirationPoints + delta).coerceIn(0, 6)))
    }

    fun awardXp(amount: Int) {
        val c = currentCharacter ?: return
        updateCharacter(c.copy(experiencePoints = (c.experiencePoints + amount).coerceAtLeast(0)))
    }

    fun updateResource(resourceName: String, delta: Float) {
        val c = currentCharacter ?: return
        fun coerce(v: Float, max: Float) = (v + delta).coerceIn(0f, max)
        val updated = when (resourceName) {
            "quar"   -> c.copy(quarResource   = coerce(c.quarResource,   c.maxQuarResource))
            "ombra"  -> c.copy(ombraResource  = coerce(c.ombraResource,  c.maxOmbraResource))
            "veruna" -> c.copy(verunaResource = coerce(c.verunaResource, c.maxVerunaResource))
            "sumeni" -> c.copy(sumeniResource = coerce(c.sumeniResource, c.maxSumeniResource))
            else     -> c
        }
        updateCharacter(updated)
    }

    fun gmFullUpdateCharacter(updated: Character) = updateCharacter(updated)

    fun openDamageDialog()  { _showDamageDialog.value = true  }
    fun closeDamageDialog() { _showDamageDialog.value = false }
    fun openArmorDialog()   { _showArmorDialog.value  = true  }
    fun closeArmorDialog()  { _showArmorDialog.value  = false }
    fun openGmEditSheet()     { _showGmEditSheet.value     = true  }
    fun closeGmEditSheet()    { _showGmEditSheet.value     = false }
    fun openPlayerEditSheet() { _showPlayerEditSheet.value = true  }
    fun closePlayerEditSheet(){ _showPlayerEditSheet.value = false }

    fun playerUpdateCharacter(updated: Character) = updateCharacter(updated)

    val currentCharacterSnapshot: Character? get() = currentCharacter

    private fun updateCharacter(character: Character) {
        currentCharacter = character
        _uiState.value = CharacterSheetUiState.Success(character)
        viewModelScope.launch { characterRepository.updateCharacter(character) }
    }
}
