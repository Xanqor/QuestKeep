package com.questkeep.ui.theme

import androidx.compose.ui.graphics.Color

// Dark fantasy background tones
val DarkBackground = Color(0xFF0D0D14)
val DarkSurface = Color(0xFF1A1A2E)
val DarkSurfaceVariant = Color(0xFF22223A)
val DarkCard = Color(0xFF1E1E30)

// Primary — deep purple/violet
val PrimaryPurple = Color(0xFF7B2FBE)
val PrimaryPurpleLight = Color(0xFF9B59E6)
val PrimaryPurpleDark = Color(0xFF5A1E8C)
val OnPrimary = Color(0xFFFFFFFF)

// Secondary — for GM features (amber/gold)
val SecondaryGold = Color(0xFFD4A017)
val SecondaryGoldLight = Color(0xFFFFCC40)
val OnSecondary = Color(0xFF1A1A00)

// Accent colors
val AccentCyan = Color(0xFF4CC9F0)       // positive actions / HP
val AccentGreen = Color(0xFF2ECC71)      // healing / buffs
val AccentRed = Color(0xFFE74C3C)        // damage / danger
val AccentOrange = Color(0xFFE67E22)     // warnings / whispers

