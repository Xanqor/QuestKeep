rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function campaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId));
    }

    function isMember(campaignId) {
      return signedIn()
        && campaign(campaignId).data.allMemberIds.hasAny([request.auth.uid]);
    }

    function isGmOrCoGm(campaignId) {
      return signedIn() && (
        campaign(campaignId).data.gmId == request.auth.uid
        || campaign(campaignId).data.coGmIds.hasAny([request.auth.uid])
      );
    }

    function joinAddsOnlyCaller() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerIds', 'allMemberIds'])
        && !(request.auth.uid in resource.data.playerIds)
        && request.auth.uid in request.resource.data.playerIds
        && request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1
        && request.resource.data.allMemberIds.size() == resource.data.allMemberIds.size() + 1
        && request.resource.data.playerIds.toSet()
            .difference(resource.data.playerIds.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.allMemberIds.toSet()
            .difference(resource.data.allMemberIds.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.playerIds.size() <= resource.data.maxPlayers;
    }

    function leaveRemovesOnlyCaller() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerIds', 'allMemberIds'])
        && request.auth.uid in resource.data.playerIds
        && !(request.auth.uid in request.resource.data.playerIds)
        && request.resource.data.playerIds.size() + 1 == resource.data.playerIds.size()
        && request.resource.data.allMemberIds.size() + 1 == resource.data.allMemberIds.size()
        && resource.data.playerIds.toSet()
            .difference(request.resource.data.playerIds.toSet()).hasOnly([request.auth.uid])
        && resource.data.allMemberIds.toSet()
            .difference(request.resource.data.allMemberIds.toSet()).hasOnly([request.auth.uid]);
    }

    // Profiles are readable only by document id to display party names; no user
    // may overwrite another account's profile.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isSelf(userId);
      allow update, delete: if isSelf(userId);

      match /notes/{noteId} {
        allow read, write: if isSelf(userId);
      }
    }

    // Do not allow campaign-code enumeration. A server function should later
    // own one-time invite consumption/revocation.
    match /invite_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.gmId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.gmId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      // Required by the existing join flow after lookup of an opaque invite id.
      // Listing remains constrained by the allMemberIds client query.
      allow get: if signedIn();
      allow list: if isMember(campaignId);
      allow create: if signedIn()
        && request.resource.data.gmId == request.auth.uid
        && request.resource.data.allMemberIds.hasOnly([request.auth.uid]);
      allow update: if isGmOrCoGm(campaignId)
        || (signedIn() && joinAddsOnlyCaller())
        || (signedIn() && leaveRemovesOnlyCaller());
      allow delete: if signedIn() && resource.data.gmId == request.auth.uid;

      match /treasury/{docId} {
        allow read, write: if isMember(campaignId);
      }

      match /shared_inventory/{itemId} {
        allow read, write: if isMember(campaignId);
      }

      match /inventory/{itemId} {
        allow read, write: if isMember(campaignId);
      }

      match /messages/{messageId} {
        allow read: if isMember(campaignId);
        allow create: if isMember(campaignId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isGmOrCoGm(campaignId)
          || (isMember(campaignId) && resource.data.senderId == request.auth.uid);
      }

      match /gm_notes/{noteId} {
        allow read, write: if isGmOrCoGm(campaignId);
      }

      match /npc_cards/{npcId} {
        allow read, write: if isGmOrCoGm(campaignId);
      }

      match /player_npcs/{npcId} {
        allow read, write: if isMember(campaignId);
      }

      match /item_cards/{cardId} {
        allow read: if isMember(campaignId);
        allow write: if isGmOrCoGm(campaignId);
      }
    }

    match /characters/{characterId} {
      allow read: if signedIn() && isMember(resource.data.campaignId);
      allow create: if signedIn()
        && request.resource.data.playerId == request.auth.uid
        && isMember(request.resource.data.campaignId);
      allow update, delete: if signedIn() && (
        resource.data.playerId == request.auth.uid
        || isGmOrCoGm(resource.data.campaignId)
      );

      match /inventory/{itemId} {
        allow read, write: if signedIn()
          && isMember(get(/databases/$(database)/documents/characters/$(characterId)).data.campaignId);
      }

      match /spells/{spellId} {
        allow read, write: if signedIn()
          && isMember(get(/databases/$(database)/documents/characters/$(characterId)).data.campaignId);
      }
    }
  }
}
